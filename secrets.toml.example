# Copie o conteúdo para: Streamlit Cloud > App > Settings > Secrets
# (ou para .streamlit/secrets.toml localmente — NUNCA suba esse arquivo para o GitHub)
#
# Para gerar o hash de uma senha:
#   python -c "import auth; print(auth.gerar_hash('minha_senha'))"
# (rode dentro da pasta do projeto, com o ambiente ativo)

[usuarios.mateus]
nome = "Mateus"
senha_hash = "COLE_AQUI_O_HASH_GERADO"

